{
  "name": "aspycharm",
  "displayName": "AsPycharm",
  "description": "Compare Folders (moshfeu/vscode-compare-folders) + Refresh Explorer in the Explorer context menu + PyCharm-like Python snippets (un4gt/pycharm-like-snippets) + PyCharm-style run configurations (yingbo/charmrun) + Ctrl+Click links in Python docstrings and comments (rufatpro py-doc-links) + a PyCharm-style Debug panel, as one extension.",
  "version": "2.4.0",
  "repository": {
    "type": "git",
    "url": "http://192.168.3.241:3000/catalinpop/VSCodeAsPycharm"
  },
  "keywords": [
    "compare",
    "compare folders",
    "diff",
    "diff folders",
    "python",
    "snippets",
    "pycharm",
    "run configuration",
    "launch.json",
    "docstring",
    "sphinx",
    "debug"
  ],
  "icon": "resources/icon.png",
  "galleryBanner": {
    "color": "#ffbe6c",
    "theme": "light"
  },
  "publisher": "catalinpop",
  "author": {
    "name": "Mosh Feuchtwanger",
    "email": "moshfeu.dev@gmail.com",
    "url": "https://twitter.com/moshfeu"
  },
  "engines": {
    "vscode": "^1.73.0",
    "node": ">=20.0.0"
  },
  "categories": [
    "Snippets",
    "Debuggers",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Runs commands from launch.json and settings (run configurations, before-launch steps, file parsing rules)."
    }
  },
  "main": "./out/extension.js",
  "l10n": "./l10n",
  "contributes": {
    "icons": {
      "comparefolders-icon": {
        "description": "%ext.icon.description%",
        "default": {
          "fontPath": "resources/fonts/comparefolders.woff",
          "fontCharacter": "\\e900"
        }
      }
    },
    "configuration": [
      {
        "type": "object",
        "title": "%ext.configuration.title%",
        "properties": {
          "compareFolders.folderLeft": {
            "type": "string",
            "description": "%ext.config.folderLeft.description%",
            "default": "",
            "scope": "resource"
          },
          "compareFolders.folderRight": {
            "type": "string",
            "description": "%ext.config.folderRight.description%",
            "default": "",
            "scope": "resource"
          },
          "compareFolders.compareContent": {
            "type": "boolean",
            "default": true,
            "description": "%ext.config.compareContent.description%",
            "scope": "resource"
          },
          "compareFolders.ignoreLineEnding": {
            "type": "boolean",
            "default": false,
            "description": "%ext.config.ignoreLineEnding.description%",
            "scope": "resource"
          },
          "compareFolders.ignoreWhiteSpaces": {
            "type": "boolean",
            "default": false,
            "description": "%ext.config.ignoreWhiteSpaces.description%",
            "scope": "resource"
          },
          "compareFolders.ignoreAllWhiteSpaces": {
            "type": "boolean",
            "default": false,
            "description": "%ext.config.ignoreAllWhiteSpaces.description%",
            "scope": "resource"
          },
          "compareFolders.ignoreEmptyLines": {
            "type": "boolean",
            "default": false,
            "description": "%ext.config.ignoreEmptyLines.description%",
            "scope": "resource"
          },
          "compareFolders.ignoreFileNameCase": {
            "type": "boolean",
            "default": true,
            "description": "%ext.config.ignoreFileNameCase.description%",
            "scope": "resource"
          },
          "compareFolders.ignoreExtension": {
            "type": "array",
            "default": [],
            "description": "%ext.config.ignoreExtension.description%",
            "scope": "resource"
          },
          "compareFolders.includeFilter": {
            "type": "array",
            "description": "%ext.config.includeFilter.description%",
            "scope": "resource"
          },
          "compareFolders.excludeFilter": {
            "type": "array",
            "description": "%ext.config.excludeFilter.description%",
            "scope": "resource"
          },
          "compareFolders.respectGitIgnore": {
            "type": "boolean",
            "description": "%ext.config.respectGitIgnore.description%",
            "scope": "resource"
          },
          "compareFolders.diffViewTitle": {
            "type": "string",
            "default": "name only",
            "enum": [
              "name only",
              "compared path",
              "full path"
            ],
            "enumDescriptions": [
              "%ext.config.diffViewTitle.enum.nameOnly%",
              "%ext.config.diffViewTitle.enum.comparedPath%",
              "%ext.config.diffViewTitle.enum.fullPath%"
            ],
            "markdownDescription": "%ext.config.diffViewTitle.description%",
            "scope": "window"
          },
          "compareFolders.diffLayout": {
            "type": "string",
            "default": "local <> compared",
            "enum": [
              "local <> compared",
              "compared <> local"
            ],
            "enumDescriptions": [
              "%ext.config.diffLayout.enum.localCompared%",
              "%ext.config.diffLayout.enum.comparedLocal%"
            ],
            "markdownDescription": "%ext.config.diffLayout.description%",
            "scope": "window"
          },
          "compareFolders.defaultDiffViewMode": {
            "type": "string",
            "default": "tree",
            "enum": [
              "tree",
              "list"
            ],
            "enumDescriptions": [
              "%ext.config.defaultDiffViewMode.enum.tree%",
              "%ext.config.defaultDiffViewMode.enum.list%"
            ],
            "scope": "window"
          },
          "compareFolders.showIdentical": {
            "type": "boolean",
            "default": false,
            "description": "%ext.config.showIdentical.description%",
            "scope": "resource"
          },
          "compareFolders.showFileCount": {
            "type": "boolean",
            "default": false,
            "description": "%ext.config.showFileCount.description%",
            "scope": "window"
          },
          "compareFolders.useDiffMerge": {
            "type": "boolean",
            "default": false,
            "description": "%ext.config.useDiffMerge.description%",
            "scope": "window"
          },
          "compareFolders.warnBeforeDelete": {
            "type": "boolean",
            "default": true,
            "description": "%ext.config.warnBeforeDelete.description%",
            "scope": "resource"
          },
          "compareFolders.warnBeforeTake": {
            "type": "boolean",
            "default": true,
            "description": "%ext.config.warnBeforeTake.description%",
            "scope": "resource"
          },
          "compareFolders.ignoreStrings": {
            "type": "array",
            "default": [],
            "items": {
              "type": "string"
            },
            "description": "%ext.config.ignoreStrings.description%",
            "scope": "resource"
          },
          "compareFolders.fileParsingRules": {
            "type": "array",
            "default": [],
            "description": "%ext.config.fileParsingRules.description%",
            "items": {
              "type": "object",
              "properties": {
                "pattern": {
                  "type": "string",
                  "description": "%ext.config.fileParsingRules.pattern.description%"
                },
                "command": {
                  "type": "string",
                  "description": "%ext.config.fileParsingRules.command.description%"
                },
                "args": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "%ext.config.fileParsingRules.args.description%"
                },
                "workingDirectory": {
                  "type": "string",
                  "description": "%ext.config.fileParsingRules.workingDirectory.description%"
                },
                "timeout": {
                  "type": "number",
                  "default": 30000,
                  "description": "%ext.config.fileParsingRules.timeout.description%"
                },
                "env": {
                  "type": "object",
                  "description": "%ext.config.fileParsingRules.env.description%",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "pattern",
                "command",
                "args"
              ]
            },
            "scope": "resource"
          }
        }
      },
      {
        "title": "AsPycharm: Debug panel",
        "properties": {
          "aspycharm.debug.showPanelOnBreakpoint": {
            "type": "boolean",
            "default": true,
            "description": "Bring the PyCharm-style Debug panel forward when the program stops (breakpoint, step, exception)."
          },
          "aspycharm.debug.groupAttributes": {
            "type": "boolean",
            "default": true,
            "description": "In Python debugging, group an object's protected (_x), special (__x__) and function members under their own nodes, as PyCharm does (debugpy 'variablePresentation'; a launch configuration that sets it wins)."
          }
        }
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "pycharm-like-snippets.printExpression",
          "when": "editorLangId == python && !editorReadonly"
        },
        {
          "command": "foldersCompare.refresh",
          "when": "false"
        },
        {
          "command": "foldersCompare.chooseFoldersAndCompare",
          "when": "false"
        },
        {
          "command": "foldersCompare.compareFoldersAgainstWorkspace",
          "when": "workspaceFolderCount != 0"
        },
        {
          "command": "foldersCompare.compareSelectedFolders",
          "when": "false"
        },
        {
          "command": "foldersCompare.copyToCompared",
          "when": "false"
        },
        {
          "command": "foldersCompare.copyToMy",
          "when": "false"
        },
        {
          "command": "foldersCompare.takeMyFile",
          "when": "false"
        },
        {
          "command": "foldersCompare.dismissDifference",
          "when": "false"
        },
        {
          "command": "foldersCompare.takeComparedFile",
          "when": "false"
        },
        {
          "command": "foldersCompare.deleteFile",
          "when": "false"
        },
        {
          "command": "foldersCompare.excludeFromComparison",
          "when": "false"
        },
        {
          "command": "charmrun.runConfigFromTree",
          "when": "false"
        },
        {
          "command": "charmrun.debugConfigFromTree",
          "when": "false"
        },
        {
          "command": "charmrun.treeItemActivated",
          "when": "false"
        },
        {
          "command": "aspycharm.debug.frameUp",
          "when": "inDebugMode"
        },
        {
          "command": "aspycharm.debug.frameDown",
          "when": "inDebugMode"
        },
        {
          "command": "charmrun.runFile",
          "when": "editorLangId == python"
        },
        {
          "command": "charmrun.debugFile",
          "when": "editorLangId == python"
        },
        {
          "command": "charmrun.modifyFileConfiguration",
          "when": "editorLangId == python"
        },
        {
          "command": "aspycharm.debug.showExecutionPoint",
          "when": "inDebugMode"
        },
        {
          "command": "aspycharm.debug.stepIntoMyCode",
          "when": "inDebugMode"
        },
        {
          "command": "aspycharm.debug.runToCursor",
          "when": "inDebugMode"
        },
        {
          "command": "aspycharm.debug.evaluateExpression",
          "when": "inDebugMode"
        }
      ],
      "view/title": [
        {
          "command": "foldersCompare.viewAsList",
          "group": "navigation@1",
          "when": "view == foldersCompareAppService && foldersCompareContext.hasFolders && foldersCompare.diffViewMode == 'tree'"
        },
        {
          "command": "foldersCompare.viewAsTree",
          "group": "navigation@1",
          "when": "view == foldersCompareAppService && foldersCompareContext.hasFolders && foldersCompare.diffViewMode == 'list'"
        },
        {
          "command": "foldersCompare.refresh",
          "group": "navigation@2",
          "when": "view == foldersCompareAppService && foldersCompareContext.hasFolders"
        },
        {
          "command": "foldersCompare.swap",
          "group": "navigation@3",
          "when": "view == foldersCompareAppService && foldersCompareContext.hasFolders"
        },
        {
          "command": "foldersCompare.pickFromRecentCompares",
          "group": "navigation@4",
          "when": "view == foldersCompareAppService"
        },
        {
          "command": "charmrun.openConfigurationFlow",
          "when": "view == charmrun.configurationsView",
          "group": "navigation"
        },
        {
          "command": "charmrun.refreshConfigurations",
          "when": "view == charmrun.configurationsView",
          "group": "navigation"
        },
        {
          "command": "charmrun.adoptLaunchConfiguration",
          "when": "view == charmrun.configurationsView",
          "group": "navigation@9"
        }
      ],
      "explorer/context": [
        {
          "command": "foldersCompare.compareSelectedFolders",
          "when": "explorerResourceIsFolder && listDoubleSelection"
        },
        {
          "command": "workbench.files.action.refreshFilesExplorer",
          "group": "navigation"
        },
        {
          "command": "charmrun.runFile",
          "when": "!explorerResourceIsFolder && resourceExtname =~ /^\\.pyw?$/i",
          "group": "1_charmrun@1"
        },
        {
          "command": "charmrun.debugFile",
          "when": "!explorerResourceIsFolder && resourceExtname =~ /^\\.pyw?$/i",
          "group": "1_charmrun@2"
        },
        {
          "command": "charmrun.modifyFileConfiguration",
          "when": "!explorerResourceIsFolder && resourceExtname =~ /^\\.pyw?$/i",
          "group": "1_charmrun@3"
        }
      ],
      "view/item/context": [
        {
          "command": "foldersCompare.copyToCompared",
          "when": "view == foldersCompareAppServiceOnlyA && viewItem != root",
          "group": "inline@2"
        },
        {
          "command": "foldersCompare.copyToMy",
          "when": "view == foldersCompareAppServiceOnlyB && viewItem != root",
          "group": "inline@2"
        },
        {
          "command": "foldersCompare.deleteFile",
          "when": "(view == foldersCompareAppServiceOnlyA || view == foldersCompareAppServiceOnlyB) && viewItem != root",
          "group": "inline@3"
        },
        {
          "command": "foldersCompare.viewParsedDiff",
          "when": "view == foldersCompareAppService && viewItem == file-parsable",
          "group": "inline@1"
        },
        {
          "command": "foldersCompare.takeMyFile",
          "when": "view == foldersCompareAppService && (viewItem == file || viewItem == file-parsable)",
          "group": "inline@2"
        },
        {
          "command": "foldersCompare.takeComparedFile",
          "when": "view == foldersCompareAppService && (viewItem == file || viewItem == file-parsable)",
          "group": "inline@3"
        },
        {
          "command": "foldersCompare.dismissDifference",
          "when": "view == foldersCompareAppService && (viewItem == file || viewItem == file-parsable)",
          "group": "inline@4"
        },
        {
          "command": "foldersCompare.excludeFromComparison",
          "when": "view =~ /^foldersCompareAppService/ && (viewItem == file || viewItem == file-parsable || viewItem == folder)",
          "group": "inline@0"
        },
        {
          "command": "foldersCompare.excludeFromComparison",
          "when": "view =~ /^foldersCompareAppService/ && (viewItem == file || viewItem == file-parsable || viewItem == folder)"
        },
        {
          "command": "charmrun.runConfigFromTree",
          "when": "view == charmrun.configurationsView && viewItem == runConfiguration",
          "group": "inline@1"
        },
        {
          "command": "charmrun.debugConfigFromTree",
          "when": "view == charmrun.configurationsView && viewItem == runConfiguration",
          "group": "inline@2"
        },
        {
          "command": "charmrun.editConfiguration",
          "when": "view == charmrun.configurationsView && viewItem == runConfiguration",
          "group": "1_actions@1"
        },
        {
          "command": "charmrun.duplicateConfiguration",
          "when": "view == charmrun.configurationsView && viewItem == runConfiguration",
          "group": "1_actions@2"
        },
        {
          "command": "charmrun.deleteConfiguration",
          "when": "view == charmrun.configurationsView && viewItem == runConfiguration",
          "group": "2_destructive@1"
        }
      ],
      "editor/context": [
        {
          "command": "charmrun.runFile",
          "when": "editorLangId == python && resourceScheme == file",
          "group": "1_charmrun@1"
        },
        {
          "command": "charmrun.debugFile",
          "when": "editorLangId == python && resourceScheme == file",
          "group": "1_charmrun@2"
        },
        {
          "command": "charmrun.modifyFileConfiguration",
          "when": "editorLangId == python && resourceScheme == file",
          "group": "1_charmrun@3"
        }
      ]
    },
    "snippets": [
      {
        "language": "python",
        "path": "./snippets/python.code-snippets"
      }
    ],
    "keybindings": [
      {
        "command": "pycharm-like-snippets.printExpression",
        "key": "alt+p",
        "when": "editorTextFocus && !editorReadonly && editorLangId == python"
      },
      {
        "command": "aspycharm.debug.frameUp",
        "key": "ctrl+alt+up",
        "mac": "cmd+alt+up",
        "when": "inDebugMode && debugState == 'stopped'"
      },
      {
        "command": "aspycharm.debug.frameDown",
        "key": "ctrl+alt+down",
        "mac": "cmd+alt+down",
        "when": "inDebugMode && debugState == 'stopped'"
      },
      {
        "command": "charmrun.runFile",
        "key": "ctrl+shift+f10",
        "mac": "ctrl+shift+r",
        "when": "editorTextFocus && editorLangId == python && resourceScheme == file"
      },
      {
        "command": "charmrun.debugFile",
        "key": "ctrl+shift+f9",
        "mac": "ctrl+shift+d",
        "when": "editorTextFocus && editorLangId == python && resourceScheme == file"
      },
      {
        "command": "aspycharm.debug.showExecutionPoint",
        "key": "alt+f10",
        "when": "inDebugMode && debugState == 'stopped'"
      },
      {
        "command": "aspycharm.debug.stepIntoMyCode",
        "key": "alt+shift+f7",
        "when": "inDebugMode && debugState == 'stopped'"
      },
      {
        "command": "aspycharm.debug.runToCursor",
        "key": "alt+f9",
        "when": "inDebugMode && debugState == 'stopped'"
      },
      {
        "command": "aspycharm.debug.evaluateExpression",
        "key": "alt+f8",
        "when": "inDebugMode && debugState == 'stopped'"
      }
    ],
    "commands": [
      {
        "title": "Wrap Line in print()",
        "command": "pycharm-like-snippets.printExpression",
        "category": "AsPycharm"
      },
      {
        "title": "%ext.command.pickFromRecent.title%",
        "command": "foldersCompare.pickFromRecentCompares",
        "icon": "$(history)",
        "category": "%ext.command.category%"
      },
      {
        "title": "%ext.command.clearRecent.title%",
        "command": "foldersCompare.clearRecentCompares",
        "category": "%ext.command.category%"
      },
      {
        "title": "%ext.command.copyToCompared.title%",
        "command": "foldersCompare.copyToCompared",
        "icon": "$(files)"
      },
      {
        "title": "%ext.command.copyToMy.title%",
        "command": "foldersCompare.copyToMy",
        "icon": "$(files)"
      },
      {
        "title": "%ext.command.deleteFile.title%",
        "command": "foldersCompare.deleteFile",
        "icon": "$(trash)"
      },
      {
        "title": "%ext.command.dismissDifference.title%",
        "command": "foldersCompare.dismissDifference",
        "icon": "$(close)"
      },
      {
        "title": "%ext.command.excludeFromComparison.title%",
        "command": "foldersCompare.excludeFromComparison",
        "icon": "$(exclude)"
      },
      {
        "title": "%ext.command.viewParsedDiff.title%",
        "command": "foldersCompare.viewParsedDiff",
        "icon": "$(code)",
        "category": "%ext.command.category%"
      },
      {
        "title": "%ext.command.takeMyFile.title%",
        "command": "foldersCompare.takeMyFile",
        "icon": "$(debug-step-over)"
      },
      {
        "title": "%ext.command.takeComparedFile.title%",
        "command": "foldersCompare.takeComparedFile",
        "icon": "$(debug-step-back)"
      },
      {
        "title": "%ext.command.chooseFolders.title%",
        "command": "foldersCompare.chooseFoldersAndCompare",
        "category": "%ext.command.category%"
      },
      {
        "title": "%ext.command.compareAgainstWorkspace.title%",
        "command": "foldersCompare.compareFoldersAgainstWorkspace",
        "category": "%ext.command.category%"
      },
      {
        "title": "%ext.command.choose2Folders.title%",
        "command": "foldersCompare.compareFoldersAgainstEachOther",
        "category": "%ext.command.category%"
      },
      {
        "title": "%ext.command.refresh.title%",
        "command": "foldersCompare.refresh",
        "icon": "$(refresh)",
        "category": "%ext.command.category%"
      },
      {
        "title": "%ext.command.swapSides.title%",
        "command": "foldersCompare.swap",
        "icon": "$(arrow-swap)",
        "category": "%ext.command.category%"
      },
      {
        "title": "%ext.command.viewAsList.title%",
        "command": "foldersCompare.viewAsList",
        "icon": "$(list-selection)",
        "category": "%ext.command.category%"
      },
      {
        "title": "%ext.command.viewAsTree.title%",
        "command": "foldersCompare.viewAsTree",
        "icon": "$(list-tree)",
        "category": "%ext.command.category%"
      },
      {
        "command": "foldersCompare.compareSelectedFolders",
        "title": "%ext.command.compareSelected.title%",
        "category": "%ext.command.category%"
      },
      {
        "command": "charmrun.runConfiguration",
        "title": "Run Configuration",
        "category": "PyCharm-style Run",
        "icon": "$(play)"
      },
      {
        "command": "charmrun.debugConfiguration",
        "title": "Debug Configuration",
        "category": "PyCharm-style Run",
        "icon": "$(bug)"
      },
      {
        "command": "charmrun.runCurrentFile",
        "title": "Run Current Python File",
        "category": "PyCharm-style Run"
      },
      {
        "command": "charmrun.debugCurrentFile",
        "title": "Debug Current Python File",
        "category": "PyCharm-style Run"
      },
      {
        "command": "charmrun.openConfigurationFlow",
        "title": "Add Configuration",
        "category": "PyCharm-style Run",
        "icon": "$(add)"
      },
      {
        "command": "charmrun.createConfiguration",
        "title": "Create Configuration",
        "category": "PyCharm-style Run",
        "icon": "$(add)"
      },
      {
        "command": "charmrun.editConfiguration",
        "title": "Edit Configuration",
        "category": "PyCharm-style Run",
        "icon": "$(edit)"
      },
      {
        "command": "charmrun.deleteConfiguration",
        "title": "Delete Configuration",
        "category": "PyCharm-style Run",
        "icon": "$(trash)"
      },
      {
        "command": "charmrun.duplicateConfiguration",
        "title": "Duplicate Configuration",
        "category": "PyCharm-style Run",
        "icon": "$(copy)"
      },
      {
        "command": "charmrun.selectActiveConfig",
        "title": "Select Active Configuration",
        "category": "PyCharm-style Run"
      },
      {
        "command": "charmrun.adoptLaunchConfiguration",
        "title": "Adopt launch.json Configuration",
        "category": "PyCharm-style Run"
      },
      {
        "command": "charmrun.refreshConfigurations",
        "title": "Refresh Configurations",
        "category": "PyCharm-style Run",
        "icon": "$(refresh)"
      },
      {
        "command": "charmrun.runConfigFromTree",
        "title": "Run",
        "category": "PyCharm-style Run",
        "icon": "$(play)"
      },
      {
        "command": "charmrun.debugConfigFromTree",
        "title": "Debug",
        "category": "PyCharm-style Run",
        "icon": "$(bug)"
      },
      {
        "command": "charmrun.treeItemActivated",
        "title": "Open Run Configuration",
        "category": "PyCharm-style Run"
      },
      {
        "command": "aspycharm.debug.showPanel",
        "title": "Show PyCharm-style Debug Panel",
        "category": "AsPycharm"
      },
      {
        "command": "aspycharm.debug.frameUp",
        "title": "Debug: Previous Frame (Up the Call Stack)",
        "category": "AsPycharm"
      },
      {
        "command": "aspycharm.debug.frameDown",
        "title": "Debug: Next Frame (Down the Call Stack)",
        "category": "AsPycharm"
      },
      {
        "command": "charmrun.runFile",
        "title": "Run Python File (PyCharm-style)",
        "category": "PyCharm-style Run",
        "icon": "$(play)"
      },
      {
        "command": "charmrun.debugFile",
        "title": "Debug Python File (PyCharm-style)",
        "category": "PyCharm-style Run",
        "icon": "$(debug-alt)"
      },
      {
        "command": "charmrun.modifyFileConfiguration",
        "title": "Modify Run Configuration...",
        "category": "PyCharm-style Run"
      },
      {
        "command": "aspycharm.debug.showExecutionPoint",
        "title": "Debug: Show Execution Point",
        "category": "AsPycharm",
        "icon": "$(target)"
      },
      {
        "command": "aspycharm.debug.stepIntoMyCode",
        "title": "Debug: Step Into My Code",
        "category": "AsPycharm"
      },
      {
        "command": "aspycharm.debug.runToCursor",
        "title": "Debug: Run to Cursor",
        "category": "AsPycharm"
      },
      {
        "command": "aspycharm.debug.evaluateExpression",
        "title": "Debug: Evaluate Expression...",
        "category": "AsPycharm"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "foldersCompare",
          "title": "%ext.viewContainer.title%",
          "icon": "$(comparefolders-icon)"
        },
        {
          "id": "charmrun-explorer",
          "title": "PyCharm-style Run",
          "icon": "resources/charmrun/icon.svg"
        }
      ],
      "panel": [
        {
          "id": "aspycharmDebug",
          "title": "Debug",
          "icon": "resources/debugPanel/debug.svg"
        }
      ]
    },
    "views": {
      "foldersCompare": [
        {
          "id": "foldersCompareAppService",
          "name": "%ext.view.differences.name%"
        },
        {
          "id": "foldersCompareAppServiceOnlyA",
          "name": "%ext.view.onlyInMy.name%"
        },
        {
          "id": "foldersCompareAppServiceOnlyB",
          "name": "%ext.view.onlyInCompared.name%"
        },
        {
          "id": "foldersCompareAppServiceIdenticals",
          "name": "%ext.view.identicals.name%",
          "when": "config.compareFolders.showIdentical"
        }
      ],
      "charmrun-explorer": [
        {
          "id": "charmrun.configurationsView",
          "name": "Run Configurations",
          "icon": "resources/charmrun/icon.svg",
          "contextualTitle": "Python Run Configurations"
        }
      ],
      "aspycharmDebug": [
        {
          "type": "webview",
          "id": "aspycharm.debugPanel",
          "name": "Debug"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "charmrun.configurationsView",
        "contents": "PyCharm-style Run stores managed Python run configurations in `.vscode/launch.json`.\n[Add Configuration](command:charmrun.openConfigurationFlow)"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "yarn run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "yarn run compile",
    "test": "node ./out/test/runTest.js",
    "l10n:extract": "npx @vscode/l10n-dev export --outDir ./l10n ./src/**/*.ts",
    "l10n:validate": "node scripts/validate-l10n.js",
    "deploy": "npx vsce publish -p",
    "deploy:insider": "node scripts/deploy-insider.js",
    "deploy:openvsx": "sh scripts/deploy-openvsx.sh",
    "package": "npx vsce package",
    "package:test": "sh scripts/package-test.sh"
  },
